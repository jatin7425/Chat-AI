# Copy this file to `.secrets` (gitignored, never commit it) and fill in real values
# to run GitHub Actions workflows locally via `act`.

# Used by .github/workflows/firebase-app-distribution.yml
FIREBASE_APP_ID=
FIREBASE_TOKEN=

