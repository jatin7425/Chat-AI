# Server
PORT=8787

# Firebase Admin SDK -- paste the *contents* of the service account JSON
# (Project Settings -> Service Accounts -> Generate new private key), base64-encoded:
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Never commit the raw JSON or this .env file.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_PROJECT_ID=sould-ai

# LLM (OpenAI-compatible chat-completions endpoint, same shape the mobile app's LiteLlmApi uses)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=

# Orchestrator tick loop -- local dev only. In production this is replaced by an
# authenticated endpoint that Vercel Cron calls instead (see src/scheduler/localLoop.ts).
RUN_LOCAL_TICK_LOOP=true
TICK_INTERVAL_CRON=*/30 * * * * *
