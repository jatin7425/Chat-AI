# Firebase Admin SDK -- same pattern as backend/.env.example: paste the *contents* of the
# service account JSON (Project Settings -> Service Accounts -> Generate new private key),
# base64-encoded:
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_PROJECT_ID=

# Public Firebase Web config (NOT secrets -- these identify the Firebase project for the
# client-side login page's Firebase Auth JS SDK, same values already baked into the Android
# app's google-services.json). Find them in Firebase Console -> Project Settings -> General ->
# "Your apps" -> Web app (create one if none exists yet; it's free and needs no extra setup).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

# The exact origin this service is deployed at (e.g. https://spaces-mcp.vercel.app) -- required
# so the OAuth metadata documents (RFC 8414/9728) can self-reference their own endpoints. Set
# this to your Vercel deployment's production URL; must not have a trailing slash.
ISSUER_URL=
